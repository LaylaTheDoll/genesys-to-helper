# Required
DISCORD_TOKEN=your_bot_token_here
# Discord user ID of the tournament organizer (the only user allowed to run admin commands)
ADMIN_DISCORD_USER_ID=123456789012345678
# Guild where slash commands are registered (dev servers sync instantly)
GUILD_ID=123456789012345678

# Dashboard
DASHBOARD_PORT=6767
DASHBOARD_BIND=127.0.0.1
# Month grouping timezone. UTC is predictable; use e.g. America/Sao_Paulo if preferred.
TOURNEY_TIME_ZONE=UTC
# Set true to let non-admin players submit /tourney-report in Discord.
TOURNEY_PLAYER_REPORTING_ENABLED=false
# Required tournament channels
TOURNEY_SIGNUP_CHANNEL_ID=
TOURNEY_FIND_OPPS_CHANNEL_ID=
TOURNEY_DROPS_CHANNEL_ID=

# Editable bot copy. Placeholders: {name}, {label}, {lines}, {player}, {thread},
# {signupEmoji}, {dropEmoji},
# {round}, {rounds}, {matches}, {winnerGames}, {loserGames}, {rank}, {points}, {wins},
# {losses}, {mwp}, {omw}, and {ddd}. Use \n for a line break.
TOURNEY_MSG_SIGNUP_OPEN=**{name}** - signups open! React with {signupEmoji} to enter.
TOURNEY_MSG_DROPS_OPEN=**{name}** - react with {dropEmoji} to drop from the tournament.
TOURNEY_MSG_SIGNUP_CLOSED=Signup closed. Missing decklists: {missing}. Use /decklist before pairing.
TOURNEY_MSG_DECKLIST_SAVED=Decklist saved.
TOURNEY_MSG_TOURNAMENT_CREATED=Tournament created!
TOURNEY_MSG_TOP_CUT_STARTED=Top Cut started.
TOURNEY_MSG_TOURNAMENT_CANCELLED=Tournament cancelled and discarded.
TOURNEY_MSG_ANNOUNCEMENT_WARNING= Warning: announcement failed; see error logs.
TOURNEY_MSG_BYE=BYE - {player}
TOURNEY_MSG_PAIRING={a} vs {b} {thread}
TOURNEY_MSG_ROUND_ANNOUNCEMENT=**{label}**\n{lines}
TOURNEY_MSG_ROUND_PAIRED={label} paired ({matches} matches).
TOURNEY_MSG_ROUND_COMPLETE=Round {round} complete - /tourney-pair for the next round.
TOURNEY_MSG_RESULT_RECORDED=Result recorded: {winnerGames}-{loserGames} for winner.
TOURNEY_MSG_DOUBLE_LOSS=Round {round}: {matches} pending match(es) marked as double loss (0 pts each).
TOURNEY_MSG_DROPPED={player} dropped.
TOURNEY_MSG_TOURNAMENT_ENDED=Tournament ended - threads cleaned up, archived to history.
TOURNEY_MSG_NO_PLAYERS=No players.
TOURNEY_MSG_STANDINGS_ROW=**{rank}.** {name} - {points} pts ({wins}-{losses}), MWP {mwp}%, OMW {omw}%, DDD {ddd}
TOURNEY_MSG_STANDINGS=**Standings - {name}**\n{lines}\n\n*Konami v2.5 standings*

# Editable validation/error copy
TOURNEY_ERR_ADMIN_ONLY=admin only
TOURNEY_ERR_CONFIGURE_CHANNELS=configure the three TOURNEY_*_CHANNEL_ID variables
TOURNEY_ERR_BOT_CHANNEL_ACCESS=bot cannot access one of the configured tournament channels
TOURNEY_ERR_DECKLIST_URL=provide a complete http(s) decklist URL under 2048 characters
TOURNEY_MSG_ERROR_PREFIX=Error: {message}
TOURNEY_ERR_PLAYER_REPORTING_DISABLED=player match reporting is disabled; ask the TO to report it
TOURNEY_ERR_CHANNELS_UNAVAILABLE=signup and drop channels are unavailable
TOURNEY_ERR_INVALID_NAME=tournament name must be 1-100 characters
TOURNEY_ERR_ALREADY_RUNNING=a tournament is already in progress
TOURNEY_ERR_SIGNUP_CLOSED=signup is already closed
TOURNEY_ERR_NO_PLAYERS=no players signed up
TOURNEY_ERR_ENDED=tournament ended
TOURNEY_ERR_NOT_REGISTERED=you are not registered
TOURNEY_ERR_DROPPED=you dropped from the tournament
TOURNEY_ERR_DECKLIST_EXISTS=decklist already stored
TOURNEY_ERR_TOO_FEW_PLAYERS=need at least 2 active players
TOURNEY_ERR_MISSING_DECKLISTS=missing decklists: {players}
TOURNEY_ERR_PENDING_MATCHES=current round still has pending matches
TOURNEY_ERR_COMPLETE=tournament complete
TOURNEY_ERR_NO_MATCHES=no matches in progress
TOURNEY_ERR_INVALID_SCORE=invalid score - use 2-0 or 2-1
TOURNEY_ERR_NO_DUEL=no duel in current round for this user
TOURNEY_ERR_RESULT_EXISTS=result already reported
TOURNEY_ERR_ROUND_COMPLETE=round already complete
TOURNEY_ERR_NOT_PARTICIPANT=not a participant
TOURNEY_ERR_ALREADY_DROPPED=already dropped
TOURNEY_ERR_WAIT_FOR_ROUND=wait until the current round is reported
TOURNEY_ERR_DROPS_LOCKED=drops are locked after elimination brackets begin
TOURNEY_ERR_END_PENDING=finish or double-loss the current round before ending
TOURNEY_ERR_ALREADY_ENDED=already ended
TOURNEY_ERR_NO_TOURNAMENT=no tournament yet - use /tourney-create
TOURNEY_ERR_NO_ROUND=no round paired yet
TOURNEY_ERR_NOT_TOP_CUT=this tournament has no Top Cut
TOURNEY_ERR_TOP_CUT_STARTED=Top Cut has already started
TOURNEY_ERR_SWISS_NOT_COMPLETE=complete {rounds} Swiss rounds before starting Top Cut
TOURNEY_ERR_TOP_CUT_REQUIRED=Swiss rounds are complete; the TO must start Top Cut
TOURNEY_ERR_CANCEL_ENDED=ended tournaments cannot be cancelled

# Tournament state and finished history are stored in data/state.json
